{
  "name": "omniwork",
  "version": "0.2.0",
  "description": "Open-source Claude Code / Cowork-style desktop agent with OmniRoute baked in. Download, open, and code with free AI models — zero setup.",
  "author": "OmniWork contributors",
  "license": "MIT",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env OMNIWORK_DEV=1 electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "icon": "node scripts/gen-icon.js",
    "test:boot": "node test/boot.js",
    "test:smoke": "node test/smoke.js",
    "test:cowork": "node test/cowork.js"
  },
  "dependencies": {
    "omniroute": "^3.8.48"
  },
  "build": {
    "appId": "com.omniwork.app",
    "productName": "OmniWork",
    "asar": true,
    "npmRebuild": false,
    "beforePack": "scripts/stage-node.js",
    "asarUnpack": [
      "node_modules/omniroute/**",
      "node_modules/better-sqlite3/**",
      "node_modules/sql.js/**"
    ],
    "files": [
      "electron/**",
      "renderer/**",
      "assets/**",
      "package.json",
      "node_modules/**/*",
      "!node_modules/omniroute/node_modules/**",
      "!node_modules/omniroute/dist/node_modules/typescript/**",
      "!node_modules/omniroute/dist/node_modules/playwright-core/**",
      "!node_modules/omniroute/dist/node_modules/@img/**",
      "!node_modules/omniroute/dist/node_modules/@ngrok/**"
    ],
    "extraResources": [
      {
        "from": "build/runtime",
        "to": "runtime"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "differentialPackage": false
    }
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
