{
  "appId": "com.omniwork.lite",
  "productName": "OmniWork Lite",
  "asar": true,
  "npmRebuild": false,
  "beforePack": "scripts/stage-node.js",
  "asarUnpack": [
    "node_modules/better-sqlite3/**",
    "node_modules/sql.js/**"
  ],
  "files": [
    "electron/**",
    "renderer/**",
    "assets/**",
    "package.json",
    "node_modules/**/*",
    "!node_modules/omniroute/**",
    "!node_modules/@tensorflow/**",
    "!node_modules/onnxruntime-node/**",
    "!node_modules/onnxruntime-web/**",
    "!node_modules/next/**",
    "!node_modules/@next/**",
    "!node_modules/mermaid/**",
    "!node_modules/monaco-editor/**",
    "!node_modules/wreq-js/**",
    "!node_modules/gpt-tokenizer/**",
    "!node_modules/js-tiktoken/**",
    "!node_modules/@huggingface/**",
    "!node_modules/@lobehub/**",
    "!node_modules/lucide-react/**",
    "!node_modules/koffi/**",
    "!node_modules/@swc/**",
    "!node_modules/tls-client-node/**",
    "!node_modules/typescript/**",
    "!node_modules/@img/**",
    "!node_modules/playwright-core/**",
    "!node_modules/@ngrok/**",
    "!node_modules/react-dom/**",
    "!node_modules/@modelcontextprotocol/**",
    "!node_modules/jsdom/**"
  ],
  "extraResources": [
    { "from": "build/runtime", "to": "runtime" }
  ],
  "directories": {
    "output": "dist",
    "buildResources": "assets"
  },
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "artifactName": "OmniWork-Lite-Setup-${version}.${ext}"
  },
  "mac": {
    "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }],
    "artifactName": "OmniWork-Lite-${version}.${ext}",
    "category": "public.app-category.developer-tools"
  },
  "linux": {
    "target": ["AppImage"],
    "artifactName": "OmniWork-Lite-${version}.${ext}",
    "icon": "assets/icon.png",
    "category": "Development"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "differentialPackage": false
  }
}
